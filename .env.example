# ==============================================================================
# Ontology-Anything configuration
# Copy this file to .env (it is read from the folder you run the command in).
# Variables already set in your shell take precedence over this file.
# ==============================================================================

# --- LLM (any OpenAI-compatible chat-completions endpoint) --------------------
OA_API_KEY=your-api-key-here
# OPENAI_API_KEY is used as a fallback when OA_API_KEY is not set.

# Defaults to https://api.openai.com/v1
# OA_BASE_URL=https://api.deepseek.com/v1          # DeepSeek
# OA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # Qwen
# OA_BASE_URL=http://localhost:11434/v1            # Ollama
# OA_BASE_URL=http://localhost:8000/v1             # vLLM

# Defaults to gpt-4o-mini
# OA_MODEL=deepseek-chat

# --- Default for `build --llm` ------------------------------------------------
# openai | record:<cassette.json> | replay:<cassette.json> | none
# OA_LLM=openai
